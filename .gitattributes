# Enforce LF line endings for text files, but keep raw CRLF in repo blobs for Windows batch scripts (so GitHub Download ZIP preserves CRLF)
* text=auto eol=lf
*.bat -text
*.cmd -text

# Explicitly mark binary files
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.obj binary
*.o binary
*.pdb binary
