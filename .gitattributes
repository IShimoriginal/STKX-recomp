# Enforce LF line endings for text files, but keep raw CRLF in repo blobs for Windows batch scripts (so GitHub Download ZIP preserves CRLF)
* text=auto eol=lf
*.bat -text
*.cmd -text

# Explicitly mark binary files
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.obj binary
*.o binary
*.pdb binary

# Exclude non-user / developer-only files from GitHub Release Source code (zip)
.github/ export-ignore
tests/ export-ignore
.clang-format export-ignore
.clang-tidy export-ignore
.cmake-format.yaml export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.gitmodules export-ignore
CONTRIBUTING.md export-ignore
manifest_candidates.toml export-ignore
