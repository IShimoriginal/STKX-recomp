# Enforce LF line endings for all text files (except Windows batch scripts which require CRLF in cmd.exe)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.obj binary
*.o binary
*.pdb binary
